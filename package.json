{
  "name": "@d4n13l-4lf4/hn-crawler",
  "version": "1.0.4",
  "description": "A CLI tool to scrape and analyze Hacker News entries",
  "main": "dist/main.js",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "bin": {
    "hn-crawler": "dist/main.js"
  },
  "directories": {
    "doc": "docs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "drizzle/migrations",
    "!dist/**/*.map",
    "!dist/**/*.d.ts"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build:js": "node esbuild.config.mts",
    "build": "npm run clean && npm run typecheck && npm run build:js",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "test:unit": "vitest run tests/unit",
    "test:coverage": "vitest run tests/unit --coverage",
    "test:acceptance": "cucumber-js tests/acceptance",
    "test:acceptance:local": "npm run build && npm install -g . && (npm run test:acceptance; EXIT_CODE=$?; npm uninstall -g hn-crawler; CLEANUP_EXIT_CODE=$?; if [ $EXIT_CODE -ne 0 ]; then exit $EXIT_CODE; else exit $CLEANUP_EXIT_CODE; fi)",
    "test:acceptance:local:env": "dotenvx run -f .env.local -- npm run test:acceptance:local",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "quality": "npm run format && npm run format:check && npm run lint && npm run typecheck && npm run test:coverage",
    "prepare": "husky install"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/d4n13l-4lf4/hn-crawler.git"
  },
  "keywords": [
    "hacker-news",
    "crawler",
    "cli"
  ],
  "author": "Daniel Aucatoma",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/d4n13l-4lf4/hn-crawler/issues"
  },
  "homepage": "https://github.com/d4n13l-4lf4/hn-crawler#readme",
  "dependencies": {
    "@libsql/client": "0.18.0",
    "axios": "1.21.1",
    "cheerio": "1.0.0",
    "commander": "12.1.0",
    "drizzle-orm": "1.0.0-rc.5",
    "env-paths": "4.0.0"
  },
  "devDependencies": {
    "@cucumber/cucumber": "10.8.0",
    "@types/node": "26.6.6",
    "@typescript-eslint/eslint-plugin": "8.73.0",
    "@typescript-eslint/parser": "8.73.0",
    "@vitest/coverage-v8": "5.1.0",
    "drizzle-kit": "1.0.0-rc.5",
    "esbuild": "0.28.2",
    "eslint": "9.19.0",
    "husky": "9.1.7",
    "prettier": "3.5.3",
    "tsx": "4.23.15",
    "typescript": "5.7.3",
    "vitest": "5.1.0"
  }
}
